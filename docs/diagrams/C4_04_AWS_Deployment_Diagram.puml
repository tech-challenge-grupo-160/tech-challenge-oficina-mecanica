AWSCloudGroup(aws) {
  RegionGroup(region, "us-east-1 (N. Virginia)") {

    APIGateway(apigw, "API Gateway", "REST + JWT Authorizer")
    ElasticContainerRegistry(ecr, "ECR", "Imagens da API")

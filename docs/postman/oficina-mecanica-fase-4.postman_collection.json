                  "if (pm.response.code < 300) { const corpo = pm.response.json(); pm.environment.set(\"pagamentoId\", corpo.id); }",
                  "if (pm.response.code < 300) { console.log('Link do Checkout Pro:', pm.response.json().linkPagamento); }"
                ]
              }
            }
          ]

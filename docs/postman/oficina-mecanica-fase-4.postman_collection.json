              "raw": "{\n  \"clienteId\": {{clienteId}},\n  \"veiculoId\": {{veiculoId}},\n  \"descricaoSolicitacao\": \"Barulho ao frear e carro puxando para a direita.\",\n  \"observacoesRecepcao\": \"Cliente aguarda o orçamento por mensagem.\",\n  \"servicos\": [ { \"servicoId\": 1000 } ],\n  \"pecas\": [ { \"pecaId\": {{pecaId}}, \"quantidade\": 2 } ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.expect(pm.response.code).to.be.oneOf([201]));",
                  "if (pm.response.code < 300) { const corpo = pm.response.json(); pm.environment.set(\"ordemServicoId\", corpo.id); }",
                  "if (pm.response.code < 300) { const corpo = pm.response.json(); pm.environment.set(\"codigoAcompanhamento\", corpo.codigoAcompanhamento); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar OS",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{osUrl}}/api/v1/ordens-servico/{{ordemServicoId}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.expect(pm.response.code).to.be.oneOf([200]));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Diagnóstico (OS Service e Execução)",
      "description": "O OS Service manda IniciarDiagnosticoMessage; a Execução abre o diagnóstico, o mecânico registra o resultado e conclui. A etapa anterior é assíncrona (SNS/SQS): se o status ainda não mudou, aguarde alguns segundos e repita.",
      "item": [
        {
          "name": "Solicitar diagnóstico",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{osUrl}}/api/v1/ordens-servico/{{ordemServicoId}}/iniciar-diagnostico"
            },
            "description": "202: a saga começa e o comando vai para a fila da Execução."
          },
          "event": [

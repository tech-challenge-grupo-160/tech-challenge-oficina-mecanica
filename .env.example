POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=oficina_mecanica
DB_PORT=5432
API_PORT=8080

# Credenciais ficticias exigidas pelo SDK AWS ao usar o LocalStack.
LOCALSTACK_ACCESS_KEY_ID=test
LOCALSTACK_SECRET_ACCESS_KEY=test

# Connection string usada pela API (Npgsql)
API_CONNECTION_STRING=Host=postgres;Database=oficina_mecanica;Username=postgres;Password=postgres

# Configurações JWT
# Minimo de 32 caracteres (256 bits): o HS256 recusa chave menor e o login devolve 400.
JWT_SECRET=troque-por-uma-chave-local-com-32-ou-mais-caracteres
JWT_ISSUER=Fiap.TechChallenge.OficinaMecanica
JWT_AUDIENCE=Fiap.TechChallenge.OficinaMecanica
